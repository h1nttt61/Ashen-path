  - "\u0430 \u0442\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0448\u044C\u0441\u044F
    \u0432 \u044D\u0442\u0438\u0445 \u0441\u0442\u0435\u043D\u0430\u0445 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430"
