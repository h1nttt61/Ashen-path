  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GuideNpc
  newLines:
  - "\u041D\u0443 \u0442\u044B \u0432\u044B\u0434\u0430\u043B, \u043A\u043E\u043D\u0435\u0447\u043D\u043E!"
