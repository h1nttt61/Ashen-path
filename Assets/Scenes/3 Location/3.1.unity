--- !u!114 &303599007
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 303599002}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dcf3ad9be98698043bccffebcf38da9f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FinaleManager
  blackScreen: {fileID: 1828937934}
  titleText: {fileID: 1615254224}
  storyText: {fileID: 1973696975}
  playerUI: {fileID: 1876813091}
  finalTitle: "\u0424\u0418\u041D\u0410\u041B"
  finalStory: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0442\u0438\u0440\u0430\u043D
    \u043F\u0430\u043B, \u0438 \u0432\u0435\u0447\u043D\u0430\u044F \u0442\u0435\u043D\u044C
    \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043F\u043E\u043A\u0438\u043D\u0443\u043B\u0430
    \u044D\u0442\u0438 \u0437\u0435\u043C\u043B\u0438.\n\n\u0418\u0441\u043A\u0440\u0430,
    \u043F\u0440\u0438\u043D\u044F\u0432 \u043A\u043E\u0440\u043E\u043D\u0443, \u043D\u0435
    \u0441\u0442\u0430\u043B \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u043B\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C.
    \u0415\u0433\u043E \u0440\u0435\u0444\u043E\u0440\u043C\u044B \u0431\u044B\u043B\u0438
    \u0441\u0443\u0440\u043E\u0432\u044B, \u043D\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B.
    \u0421 \u043A\u0430\u0436\u0434\u044B\u043C \u043D\u043E\u0432\u044B\u043C \u0437\u0430\u043A\u043E\u043D\u043E\u043C
    \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E, \u043D\u0435\u043A\u043E\u0433\u0434\u0430
    \u0441\u0442\u043E\u044F\u0432\u0448\u0435\u0435 \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445,
    \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u043E \u043F\u043B\u0435\u0447\u0438.\n\n\u0421\u043A\u0432\u043E\u0437\u044C
    \u0440\u0443\u0438\u043D\u044B \u0431\u044B\u043B\u043E\u0433\u043E \u0432\u0435\u043B\u0438\u0447\u0438\u044F
    \u043F\u0440\u043E\u0431\u0438\u043B\u0438\u0441\u044C \u0440\u043E\u0441\u0442\u043A\u0438
    \u043D\u043E\u0432\u043E\u0439 \u044D\u043F\u043E\u0445\u0438 - \u044D\u043F\u043E\u0445\u0438
    \u0418\u0441\u043A\u0440\u044B. \u0420\u0430\u0441\u0441\u0432\u0435\u0442 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B
    \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E."
