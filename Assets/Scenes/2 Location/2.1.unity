--- !u!114 &1883488436
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1883488435}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3980270e651e894db65e7261e649a25, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FireGuardianNPC
  npcName: Cinder Elder
  interactionRange: 3
  interactKey: 101
  dialogueCanvas: {fileID: 189974360}
  textDisplay: {fileID: 1769330686}
  typingSpeed: 0.05
  delayBetweenPages: 2
  firstMeeting:
    sequenceName: Hello
    pages:
    - "\u0421\u0442\u043E\u0439, \u043F\u0443\u0442\u043D\u0438\u043A..."
    - "\u041E\u0442 \u0442\u0435\u0431\u044F \u043F\u0430\u0445\u043D\u0435\u0442
      \u0434\u044B\u043C\u043E\u043C \u042D\u043C\u0431\u0435\u0440\u0430"
    - "\u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E
      \u0442\u044B \u043F\u0440\u0438\u0434\u0435\u0448\u044C"
    - "\u0422\u0432\u043E\u044F \u0438\u0441\u043A\u0440\u0430 \u0435\u0449\u0435
      \u0441\u043B\u0430\u0431\u0430, \u043D\u043E \u043E\u0433\u043E\u043D\u044C
      \u0432\u043D\u0443\u0442\u0440\u0438 \u0436\u0430\u0436\u0434\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435\u0433\u043E"
    - "\u0412\u043E\u0437\u044C\u043C\u0438 \u044D\u0442\u043E \u043E\u0431\u0433\u043E\u0440\u0435\u0432\u0448\u0435\u0435
      \u043A\u043E\u043B\u044C\u0446\u043E"
    - "\u041E\u043D\u043E \u043D\u0435 \u043F\u043E\u0442\u0443\u0448\u0438\u0442
      \u0442\u0432\u043E\u044E \u0431\u043E\u043B\u044C "
    - "\u041D\u043E \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0442\u0435\u043B\u0443
      \u043D\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F
      \u0432 \u043F\u0435\u043F\u0435\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0431\u044B\u0441\u0442\u0440\u043E"
    - "\u0411\u0435\u0440\u0435\u0433\u0438 \u0435\u0433\u043E, \u043E\u043D\u043E
      \u043F\u043E\u043C\u043D\u0438\u0442 \u0442\u0435\u043F\u043B\u043E \u043F\u0435\u0440\u0432\u044B\u0445
      \u043A\u043E\u0441\u0442\u0440\u043E\u0432"
  randomStories:
  - sequenceName: First
    pages:
    - "\u0417\u043D\u0430\u0435\u0448\u044C, \u043F\u043E\u0447\u0435\u043C\u0443
      \u043C\u044B \u0442\u0430\u043A \u0446\u0435\u043D\u0438\u043C \u0442\u0435\u043F\u043B\u043E?"
    - "\u0414\u0430\u0432\u043D\u044B\u043C-\u0434\u0430\u0432\u043D\u043E \u043C\u0438\u0440
      \u0431\u044B\u043B \u043B\u0438\u0448\u044C \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C
      \u043A\u0430\u043C\u043D\u0435\u043C"
    - "\u041D\u043E \u043F\u043E\u0442\u043E\u043C \u0443\u043F\u0430\u043B\u0430
      \u043F\u0435\u0440\u0432\u0430\u044F \u0438\u0441\u043A\u0440\u0430, \u0438
      \u0438\u0437 \u043D\u0435\u0451 \u0432\u044B\u0440\u043E\u0441\u043B\u0438
      \u043C\u044B"
    - "\u0422\u0435, \u043A\u0442\u043E \u043D\u0435\u0441\u0435\u0442 \u043E\u0433\u043E\u043D\u044C,
      \u043E\u0431\u0440\u0435\u0447\u0435\u043D\u044B \u0441\u0433\u043E\u0440\u0430\u0442\u044C,
      \u043D\u043E \u043F\u043E\u043A\u0430 \u043C\u044B \u0433\u043E\u0440\u0438\u043C
      - \u043C\u044B \u0436\u0438\u0432\u0435\u043C"
  - sequenceName: Second
    pages:
    - "\u0422\u0435 \u0442\u0432\u0430\u0440\u0438, \u0447\u0442\u043E \u0442\u044B
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0448\u044C \u0432\u043F\u0435\u0440\u0435\u0434\u0438.."
    - "\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u043E\u043D\u0441\u0442\u0440\u044B"
    - "\u042D\u0442\u043E \u0442\u0435, \u0447\u0435\u0439 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439
      \u043E\u0433\u043E\u043D\u044C \u043F\u043E\u0433\u0430\u0441"
    - "\u041E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043B\u0438\u0448\u044C
      \u043F\u0443\u0441\u0442\u0430\u044F \u0441\u0430\u0436\u0430 \u0438 \u0433\u043E\u043B\u043E\u0434"
    - "\u041E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043B\u0438\u0448\u044C
      \u043F\u0443\u0441\u0442\u0430\u044F \u0441\u0430\u0436\u0430 \u0438 \u0433\u043E\u043B\u043E\u0434"
    - "\u041D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0434\u0430\u0432\u0430\u0439
      \u0441\u0432\u043E\u0435\u043C\u0443 \u043E\u0433\u043D\u044E \u0437\u0430\u0442\u0443\u0445\u043D\u0443\u0442\u044C"
    - "\u0418\u043D\u0430\u0447\u0435 \u0441\u0442\u0430\u043D\u0435\u0448\u044C
      \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043D\u0438\u0445"
  - sequenceName: Third
    pages:
    - "\u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0432 \u043A\u043E\u043D\u0446\u0435
      '\u041F\u0435\u043F\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043F\u0443\u0442\u0438'
      \u0435\u0441\u0442\u044C \u043A\u043E\u0441\u0442\u0435\u0440"
    - "\u041A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0433\u0430\u0441\u043D\u0435\u0442"
    - "\u042D\u043C\u0431\u0435\u0440 \u0432\u0435\u0440\u0438\u0442 \u0432 \u044D\u0442\u043E"
    - "\u042F \u0436\u0435 \u0441\u0442\u0430\u0440\u044B\u0439 \u0434\u0443\u0440\u0430\u043A,
      \u043C\u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0438 \u044D\u0442\u043E\u0433\u043E \u0443\u0433\u043E\u043B\u044C\u043A\u0430"
    - "\u041D\u043E \u0442\u044B \u0438\u0434\u0438"
    - "\u041F\u043E\u043A\u0430 \u0432 \u0442\u0435\u0431\u0435 \u0435\u0441\u0442\u044C
      \u0438\u0441\u043A\u0440\u0430 - \u0435\u0441\u0442\u044C \u0438 \u043D\u0430\u0434\u0435\u0436\u0434\u0430"
  animator: {fileID: 1883488439}
